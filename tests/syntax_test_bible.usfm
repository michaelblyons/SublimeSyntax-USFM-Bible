\io1 The last week in and near Jerusalem (21.1–27.66)
\io1 The resurrection and appearances of the Lord (28.1-20)
\c 1
\z# <- meta.toc-list.chapter.usfm keyword.declaration.chapter.usfm
\z#^ meta.toc-list.chapter.usfm
\z#^ meta.number.integer.decimal.usfm constant.numeric.value.usfm
\s1 The Ancestors of Jesus Christ
\z# <- markup.heading.1.usfm punctuation.definition.heading.1.usfm
\z#^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ markup.heading.1.usfm
\z# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ entity.name.section.usfm
