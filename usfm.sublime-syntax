%YAML 1.2
---
# https://www.sublimetext.com/docs/syntax.html
# https://docs.usfm.bible
name: USFM Bible
file_extensions:
  - usfm
scope: text.usfm

contexts:
  main:
    - include: paragraphs
    - include: chapters
    - include: verses

###[ CHAPTERS & VERSES ]#######################################################

  chapters:
    - match: (\\c) ([1-9][0-9]*)\b
      scope: meta.toc-list.chapter.usfm
      captures:
        1: keyword.declaration.chapter.usfm
        2: meta.number.integer.decimal.usfm constant.numeric.base.usfm
      push: verse-body

  chapter-body:
    - meta_content_scope: markup.other.chapter.usfm
    - match: (?=\\c\b)
      pop: 1
    - include: verses

  verses:
    - match: (\\v([ap]?)) ([1-9][0-9]*)\b
      captures:
        1: keyword.declaration.verse.usfm
        2: storage.modifier.usfm
        3: meta.number.integer.decimal.usfm constant.numeric.base.usfm
      push: verse-body

  verse-body:
    - meta_content_scope: markup.other.verse.usfm
    - match: (?=\\[vc][ap]?\b)
      pop: 1
    - include: paragraphs
    - include: notes
    - include: characters

###[ PARAGRAPHS ]##############################################################

  # https://docs.usfm.bible/usfm/3.1/para/index.html
  paragraphs:
    - include: para.identifications
    - include: para.introductions
    - include: para.titles-and-sections
    - include: para.body-paragraphs
    - include: para.poetry
    - include: para.lists
    - include: para.tables

  para.identifications: []
  para.introductions: []

  para.titles-and-sections:
    - match: \\s1\b
      scope: keyword.other.section.usfm
      push: section-1-body
    - match: \\s2\b
      scope: keyword.other.section.usfm
      push: section-2-body

  section-1-body:
    - meta_scope: markup.heading.1.usfm
    - include: pop-eol

  section-2-body:
    - meta_scope: markup.heading.2.usfm
    - include: pop-eol

  para.body-paragraphs:
    - match: \\p\b
      scope: keyword.other.paragraph.usfm

  para.poetry: []
  para.lists: []
  para.tables: []

###[ CHARACTERS ]##############################################################

  # https://docs.usfm.bible/usfm/3.1/char/index.html
  characters:
    - include: char.name-of-god

  char.name-of-god:
    - match: \\nd
      scope: punctuation.definition.placeholder.begin.usfm
      push: char.name-of-god.body

  char.name-of-god.body:
    - meta_content_scope: constant.other.placeholder.usfm
    - match: \\nd\*
      scope: punctuation.definition.placeholder.end.usfm
      pop: 1

###[ NOTES ]###################################################################

  # https://docs.usfm.bible/usfm/3.1/note/index.html
  notes:
    - include: note.footnotes
    - include: note.cross-references

  # https://docs.usfm.bible/usfm/3.1/note/footnote/index.html
  note.footnotes:
    - match: \\(f|ef|fe)
      scope: punctuation.definition.annotation.begin.usfm
      push: footnote-body

  footnote-body:
    - meta_scope: markup.info.footnote.usfm
    - match: \\\1\*
      scope: punctuation.definition.annotation.end.usfm
      pop: 1

  note.cross-references: []

###[ MILESTONES ]##############################################################

  # https://docs.usfm.bible/usfm/3.1/ms/index.html
  milestones:
    - include: ms-quotations
    - include: ms-translators-sections

  ms.quotations: []
  ms.translators-sections: []

###[ PROTOTYPES ]##############################################################

  pop-eol:
    - match: $\n?
      pop: 1

  pop-before-eol:
    - match: (?=$\n?)
      pop: 1

###############################################################################

variables:
  book_identifier: |-
    (?x:
      GEN | EXO | LEV | NUM | DEU | JOS | JDG | RUT | 1SA | 2SA | 1KI | 2KI
    | 1CH | 2CH | EZR | NEH | EST | JOB | PSA | PRO | ECC | SNG | ISA | JER
    | LAM | EZK | DAN | HOS | JOL | AMO | OBA | JON | MIC | NAM | HAB | ZEP
    | HAG | ZEC | MAL
    | MAT | MRK | LUK | JHN | ACT | ROM | 1CO | 2CO | GAL | EPH | PHP | COL
    | 1TH | 2TH | 1TI | 2TI | TIT | PHM | HEB | JAS | 1PE | 2PE | 1JN | 2JN
    | 3JN | JUD | REV
    | TOB | JDT | ESG | WIS | SIR | BAR | LJE | S3Y | SUS | BEL | 1MA | 2MA
    | 3MA | 4MA | 1ES | 2ES | MAN | PS2 | ODA | PSS
    | EZA | 5EZ | 6EZ
    | DAG | PS3 | 2BA | LBA | JUB | ENO | 1MQ | 2MQ
    | 3MQ | REP | 4BA | LAO
    | FRT | BAK | OTH | INT | CNC | GLO | TDX | NDX
    | XX[A-G]
    )
